# ================================================================
# CareerWizard AI - Environment Configuration Example (main1)
# ================================================================
# Note: The backend runs completely offline WITHOUT this file by default,
# using the local SQLite database and pre-seeded backup data.
#
# When you are ready to connect to Supabase or live AI, create
# a .env file in this directory and set the values below.
# ================================================================

# --- Database Connection (Supabase / PostgreSQL) ---
# For Local SQLite (Default, no .env required):
# DATABASE_URL=sqlite:///./jobrecdb.db

# For Supabase (PostgreSQL Direct / Pooler):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Supabase API Keys (Optional) ---
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]

# --- AI Configuration (Google Gemini & Deepgram Voice) ---
# GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]
# DEEPGRAM_API_KEY=[YOUR-DEEPGRAM-API-KEY]
# DEEPGRAM_VOICE=aura-orion-en

# --- Security ---
SECRET_KEY=ultra_secret_carrier_wizard_key_2024
